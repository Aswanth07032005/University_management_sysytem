<style>
  /* ============================================
     DESIGN TOKENS
  =============================================== */
  :root{
    --rv-primary:#0B5ED7;
    --rv-primary-dark:#083f99;
    --rv-secondary:#ffffff;
    --rv-accent:#FFC107;
    --rv-light:#F8F9FA;
    --rv-ink:#0d1b2a;
    --rv-muted:#5c6b7a;
    --rv-radius-lg:22px;
    --rv-radius-md:16px;
    --rv-radius-sm:10px;
    --rv-shadow-soft:0 20px 45px -20px rgba(11,94,215,.25);
    --rv-shadow-card:0 10px 30px -12px rgba(13,27,42,.15);
    --rv-gradient-primary:linear-gradient(135deg,#0B5ED7 0%,#083f99 100%);
    --rv-gradient-gold:linear-gradient(135deg,#FFC107 0%,#e6a800 100%);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Poppins',sans-serif;
    color:var(--rv-ink);
    background:var(--rv-secondary);
    overflow-x:hidden;
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation:none !important; transition:none !important;}
  }

  h1,h2,h3,h4,h5{font-family:'Poppins',sans-serif; font-weight:700; letter-spacing:-.02em;}
  .eyebrow{
    text-transform:uppercase;
    letter-spacing:.18em;
    font-size:.78rem;
    font-weight:600;
    color:var(--rv-primary);
  }
  .eyebrow .dot{
    display:inline-block;width:8px;height:8px;border-radius:50%;
    background:var(--rv-accent);margin-right:8px;vertical-align:middle;
  }
  .text-accent{color:var(--rv-accent) !important;}
  .bg-primary-rv{background:var(--rv-primary) !important;}
  .btn-rv-primary{
    background:var(--rv-gradient-primary);
    border:none;color:#fff;font-weight:600;
    padding:.85rem 2rem;border-radius:50px;
    box-shadow:0 12px 25px -10px rgba(11,94,215,.55);
