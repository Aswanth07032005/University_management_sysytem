    color:#888;
}

.toast-progress{
    position:absolute;
    left:0;
    bottom:0;
    height:4px;
    background:#16a34a;
    width:100%;
    animation:progress 3s linear forwards;
}

.error .toast-progress{
    background:#dc2626;
}

.warning .toast-progress{
    background:#f59e0b;
}

.info .toast-progress{
    background:#2563eb;
}

@keyframes slideIn{

    from{
        opacity:0;
        transform:translateX(120%);
    }

    to{
        opacity:1;
        transform:translateX(0);
    }

}

@keyframes slideOut{

    to{
        opacity:0;
        transform:translateX(120%);
    }

}

@keyframes progress{

    from{
        width:100%;
    }

    to{
        width:0%;
    }

}
